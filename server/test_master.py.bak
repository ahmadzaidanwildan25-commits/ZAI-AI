# ============================================================
# 10. OLLAMA
# ============================================================

def ollama_test():
    url = "http://127.0.0.1:11434/api/tags"

    request = urllib.request.Request(
        url,
        method="GET",
    )

    with urllib.request.urlopen(
        request,
        timeout=5,
    ) as response:

        assert response.status == 200

        raw = response.read().decode(
            "utf-8",
            errors="replace",
        )

        data = json.loads(raw)

        assert isinstance(data, dict)

        models = data.get("models", [])

        assert isinstance(models, list)

        model_names = [
            str(model.get("name", ""))
            for model in models
            if isinstance(model, dict)
        ]

        assert any(
            name.startswith("qwen3:8b")
            for name in model_names
        ), (
            f"qwen3:8b tidak ditemukan. Models: {model_names}"
        )

    return True


test("Ollama / qwen3:8b availability", ollama_test)


# ============================================================
# 11. END-TO-END COGNITIVE PIPELINE
# ============================================================

def end_to_end_test():
    from intent.engine import get_intent_engine
    from intent.router import IntentRouter
    from memory.manager import MemoryManager
    from response.engine import ResponseEngine
    from core.orchestrator import CognitiveOrchestrator
    from core.tool_engine import get_tool_engine

    memory = MemoryManager()
    intent = get_intent_engine()
    router = IntentRouter(memory)
    response = ResponseEngine(memory)
    orchestrator = CognitiveOrchestrator(
        intent,
        router,
        response,
    )
    tools = get_tool_engine()

    # Local response
    result = orchestrator.handle("halo zai")

    assert result["handled"] is True
    assert result["route"] == "local"

    # Memory
    result = orchestrator.handle("berapa memory")

    assert result["handled"] is True
    assert result["route"] == "memory"

    # Calculator
    result = orchestrator.handle("hitung 20 + 30")

    assert result["route"] == "calculator"

    calculator = tools.execute(
        "calculator",
        "hitung 20 + 30",
    )

    assert calculator.to_dict()["data"]["result"] == 50

    # Weather routing
    result = orchestrator.handle("cuaca hari ini")

    assert result["route"] == "weather"

    # Search routing
    result = orchestrator.handle("cari berita terbaru")

    assert result["route"] == "search"

    # Coding -> LLM
    result = orchestrator.handle(
        "buatkan kode python"
    )

    assert result["route"] == "llm"
    assert result["intent"] == "coding"

    return True


test("End-to-End / ZAI cognitive pipeline", end_to_end_test)


