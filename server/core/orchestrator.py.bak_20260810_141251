from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Optional


# ============================================================
# ZAI COGNITIVE ORCHESTRATOR
# SUPER ZAI
# VERSION 0.7.0
# ============================================================


@dataclass
class CognitiveResult:
    """
    Hasil standar dari cognitive pipeline ZAI.
    """

    handled: bool
    response: Optional[str]
    route: str
    intent: str

    confidence: float = 0.0

    metadata: dict[str, Any] = field(
        default_factory=dict
    )

    error: Optional[str] = None

    def to_dict(self) -> dict[str, Any]:

        return {
            "handled": self.handled,
            "response": self.response,
            "route": self.route,
            "intent": self.intent,
            "confidence": self.confidence,
            "metadata": self.metadata,
            "error": self.error,
        }


class CognitiveOrchestrator:
    """
    Otak pengatur utama Super ZAI.

    Tugas:

    1. Menganalisis intent.
    2. Menentukan jalur eksekusi.
    3. Menjalankan local response jika tersedia.
    4. Mengarahkan kebutuhan khusus ke route yang sesuai.
    5. Mengarahkan pertanyaan umum ke LLM.
    6. Menyediakan metadata standar.
    """

    VERSION = "0.7.0"

    DEFAULT_ROUTE = "llm"

    def __init__(
        self,
        intent_engine: Any,
        router: Any,
        response_engine: Any,
    ) -> None:

        if intent_engine is None:
            raise ValueError(
                "intent_engine tidak boleh None."
            )

        if router is None:
            raise ValueError(
                "router tidak boleh None."
            )

        if response_engine is None:
            raise ValueError(
                "response_engine tidak boleh None."
            )

        self.intent_engine = intent_engine
        self.router = router
        self.response_engine = response_engine

    # ========================================================
    # NORMALIZATION
    # ========================================================

    @staticmethod
    def normalize_message(
        message: str,
    ) -> str:

        if message is None:
            return ""

        return " ".join(
            str(message)
            .strip()
            .split()
        )

    # ========================================================
    # INTENT ANALYSIS
    # ========================================================

    def analyze(
        self,
        message: str,
    ) -> dict[str, Any]:

        normalized = self.normalize_message(
            message
        )

        if not normalized:

            return {
                "intent": "empty",
                "confidence": 1.0,
                "normalized_text": "",
                "high_confidence": True,
            }

        result = self.intent_engine.analyze(
            normalized
        )

        if not isinstance(result, dict):

            intent = self.intent_engine.get_intent(
                normalized
            )

            return {
                "intent": intent,
                "confidence": 0.0,
                "normalized_text": normalized,
                "high_confidence": False,
            }

        return result

    # ========================================================
    # ROUTING
    # ========================================================

    def route(
        self,
        intent_result: dict[str, Any],
        message: str,
    ) -> dict[str, Any]:

        intent = str(
            intent_result.get(
                "intent",
                "general",
            )
        )

        confidence = float(
            intent_result.get(
                "confidence",
                0.0,
            )
        )

        # ----------------------------------------------------
        # Router API modern
        # ----------------------------------------------------

        try:

            result = self.router.route(
                intent,
                message,
            )

            if isinstance(result, dict):

                return {
                    **result,
                    "intent": result.get(
                        "intent",
                        intent,
                    ),
                    "confidence": result.get(
                        "confidence",
                        confidence,
                    ),
                }

        except (AttributeError, TypeError):

            pass

        # ----------------------------------------------------
        # Router API alternatif
        # ----------------------------------------------------

        try:

            result = self.router.handle(
                intent,
                message,
            )

            if isinstance(result, dict):

                return {
                    **result,
                    "intent": result.get(
                        "intent",
                        intent,
                    ),
                    "confidence": result.get(
                        "confidence",
                        confidence,
                    ),
                }

        except (AttributeError, TypeError):

            pass

        # ----------------------------------------------------
        # Fallback
        # ----------------------------------------------------

        return {
            "handled": False,
            "response": None,
            "route": self.DEFAULT_ROUTE,
            "intent": intent,
            "confidence": confidence,
            "metadata": {
                "requires_llm": True,
                "fallback": True,
            },
        }

    # ========================================================
    # RESPONSE ENGINE
    # ========================================================

    def respond(
        self,
        intent_result: dict[str, Any],
        route_result: dict[str, Any],
        message: str,
    ) -> dict[str, Any]:

        intent = str(
            intent_result.get(
                "intent",
                route_result.get(
                    "intent",
                    "general",
                ),
            )
        )

        confidence = float(
            route_result.get(
                "confidence",
                intent_result.get(
                    "confidence",
                    0.0,
                ),
            )
        )

        # ----------------------------------------------------
        # Router sudah menangani response
        # ----------------------------------------------------

        if route_result.get(
            "handled",
            False,
        ):

            return {
                "handled": True,
                "response": route_result.get(
                    "response"
                ),
                "route": route_result.get(
                    "route",
                    "local",
                ),
                "intent": intent,
                "confidence": confidence,
                "metadata": route_result.get(
                    "metadata",
                    {},
                ),
            }

        # ----------------------------------------------------
        # Response Engine
        # ----------------------------------------------------

        try:

            result = self.response_engine.handle(
                intent,
                message,
            )

            if hasattr(
                result,
                "to_dict",
            ):

                result = result.to_dict()

            if isinstance(
                result,
                dict,
            ):

                result.setdefault(
                    "intent",
                    intent,
                )

                result.setdefault(
                    "confidence",
                    confidence,
                )

                return result

        except (
            AttributeError,
            TypeError,
        ):

            pass

        # ----------------------------------------------------
        # Fallback
        # ----------------------------------------------------

        return {
            "handled": False,
            "response": None,
            "route": route_result.get(
                "route",
                self.DEFAULT_ROUTE,
            ),
            "intent": intent,
            "confidence": confidence,
            "metadata": {
                "requires_llm": True,
                "fallback": True,
            },
        }

    # ========================================================
    # COMPLETE PIPELINE
    # ========================================================

    def process(
        self,
        message: str,
    ) -> CognitiveResult:

        normalized = self.normalize_message(
            message
        )

        # ----------------------------------------------------
        # EMPTY
        # ----------------------------------------------------

        if not normalized:

            return CognitiveResult(
                handled=True,
                response=(
                    "Silakan masukkan pesan."
                ),
                route="local",
                intent="empty",
                confidence=1.0,
                metadata={
                    "fast_response": True,
                },
            )

        # ----------------------------------------------------
        # INTENT
        # ----------------------------------------------------

        intent_result = self.analyze(
            normalized
        )

        # ----------------------------------------------------
        # ROUTE
        # ----------------------------------------------------

        route_result = self.route(
            intent_result,
            normalized,
        )

        # ----------------------------------------------------
        # RESPONSE
        # ----------------------------------------------------

        response_result = self.respond(
            intent_result,
            route_result,
            normalized,
        )

        # ----------------------------------------------------
        # METADATA
        # ----------------------------------------------------

        metadata = dict(
            response_result.get(
                "metadata",
                {},
            )
            or {}
        )

        metadata.setdefault(
            "orchestrator",
            self.VERSION,
        )

        metadata.setdefault(
            "normalized_text",
            normalized,
        )

        metadata.setdefault(
            "intent_confidence",
            intent_result.get(
                "confidence",
                0.0,
            ),
        )

        metadata.setdefault(
            "high_confidence",
            intent_result.get(
                "high_confidence",
                False,
            ),
        )

        return CognitiveResult(
            handled=bool(
                response_result.get(
                    "handled",
                    False,
                )
            ),
            response=response_result.get(
                "response"
            ),
            route=str(
                response_result.get(
                    "route",
                    route_result.get(
                        "route",
                        self.DEFAULT_ROUTE,
                    ),
                )
            ),
            intent=str(
                response_result.get(
                    "intent",
                    intent_result.get(
                        "intent",
                        "general",
                    ),
                )
            ),
            confidence=float(
                response_result.get(
                    "confidence",
                    intent_result.get(
                        "confidence",
                        0.0,
                    ),
                )
            ),
            metadata=metadata,
            error=response_result.get(
                "error"
            ),
        )

    # ========================================================
    # SIMPLE API
    # ========================================================

    def handle(
        self,
        message: str,
    ) -> dict[str, Any]:

        return self.process(
            message
        ).to_dict()

    # ========================================================
    # STATUS
    # ========================================================

    def stats(self) -> dict[str, Any]:

        return {
            "engine": "CognitiveOrchestrator",
            "version": self.VERSION,
            "intent_engine": type(
                self.intent_engine
            ).__name__,
            "router": type(
                self.router
            ).__name__,
            "response_engine": type(
                self.response_engine
            ).__name__,
            "pipeline": [
                "intent",
                "routing",
                "response",
                "fallback",
            ],
            "status": "READY",
        }


# ============================================================
# FACTORY
# ============================================================

_orchestrator: Optional[
    CognitiveOrchestrator
] = None


def get_orchestrator(
    intent_engine: Any = None,
    router: Any = None,
    response_engine: Any = None,
) -> CognitiveOrchestrator:

    global _orchestrator

    if _orchestrator is not None:
        return _orchestrator

    if (
        intent_engine is None
        or router is None
        or response_engine is None
    ):
        raise RuntimeError(
            "CognitiveOrchestrator belum "
            "diinisialisasi."
        )

    _orchestrator = CognitiveOrchestrator(
        intent_engine=intent_engine,
        router=router,
        response_engine=response_engine,
    )

    return _orchestrator


def reset_orchestrator() -> None:

    global _orchestrator

    _orchestrator = None